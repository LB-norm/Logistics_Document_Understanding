{
  "format_version": 1,
  "name": "qwen35-9b-qlora-r16-resolution-high",
  "description": "Image-resolution comparison: Qwen3.5 9B with the default frozen-vision NF4 QLoRA rank-16 recipe at high (4.2 MP) resolution.",
  "training": {
    "model_id": "Qwen/Qwen3.5-9B",
    "model_class": "auto",
    "resolution": "high",
    "load_in_4bit": true,
    "compute_dtype": "bfloat16",
    "bnb_4bit_quant_type": "nf4",
    "gradient_checkpointing": true,
    "per_device_train_batch_size": 1,
    "per_device_eval_batch_size": 1,
    "gradient_accumulation_steps": 8,
    "num_train_epochs": 10.0,
    "learning_rate": 0.00005,
    "weight_decay": 0.01,
    "lr_scheduler_type": "cosine",
    "warmup_ratio": 0.05,
    "lora_r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "target_modules": "all-linear",
    "vision_tuning": "frozen",
    "optim": "auto",
    "attn_implementation": "sdpa",
    "eval_strategy": "epoch",
    "save_strategy": "epoch",
    "save_total_limit": 2,
    "logging_steps": 50,
    "validation_preview_samples": 2,
    "validation_preview_max_new_tokens": 2048,
    "dataloader_num_workers": 0,
    "seed": 42
  }
}
